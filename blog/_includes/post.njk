<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — Vector DSP</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://vector-dsp.com/blog/{{ page.fileSlug }}/">

<meta property="og:type" content="article">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="https://vector-dsp.com/blog/{{ page.fileSlug }}/">
<meta property="og:site_name" content="Vector DSP">
<meta property="article:published_time" content="{{ date | isoDate }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ date | isoDate }}",
  "author": { "@type": "Organization", "name": "Vector DSP" },
  "publisher": {
    "@type": "Organization",
    "name": "Vector DSP",
    "url": "https://vector-dsp.com"
  },
  "url": "https://vector-dsp.com/blog/{{ page.fileSlug }}/",
  "mainEntityOfPage": "https://vector-dsp.com/blog/{{ page.fileSlug }}/"
}
</script>

<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600&family=Barlow+Condensed:wght@400;600;700;800&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
:root {
  --bg:        #0B0D11;
  --surface:   #13161D;
  --surface2:  #1C2029;
  --line:      rgba(255,255,255,0.07);
  --purple:    #9B6DFF;
  --purple-lt: #C4A8FF;
  --purple-dim:rgba(155,109,255,0.12);
  --cyan:      #00C2FF;
  --mint:      #4DFFEC;
  --white:     #EDF0F4;
  --muted:     #5A6070;
  --muted2:    #383D4A;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg);
  color: var(--white);
  font-family: 'IBM Plex Mono', monospace;
  overflow-x: hidden;
  cursor: default;
}

/* noise overlay — matches index.html */
body::after {
  content: '';
  position: fixed; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
  background-size: 256px;
  pointer-events: none; z-index: 9999;
}

/* ─── NAV (matches index.html exactly) ─── */
nav {
  position: fixed; top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 56px;
  height: 64px;
  background: rgba(11,13,17,0.88);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--line);
}
.nav-brand {
  display: flex; align-items: center; gap: 10px;
  cursor: pointer; text-decoration: none;
}
.nav-wordmark {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 700; font-size: 21px;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--white);
}
.nav-wordmark em { color: var(--purple); font-style: normal; }
.nav-links { display: flex; align-items: center; gap: 32px; }
.nav-link {
  font-size: 16px; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--muted); text-decoration: none;
  transition: color 0.2s;
}
.nav-link:hover { color: var(--white); }
.nav-cta {
  padding: 8px 20px;
  background: var(--purple-dim);
  border: 1px solid rgba(155,109,255,0.35);
  color: var(--purple-lt);
  font-family: 'IBM Plex Mono', monospace;
  font-size: 14px; letter-spacing: 0.15em; text-transform: uppercase;
  text-decoration: none;
  transition: all 0.2s;
}
.nav-cta:hover {
  background: rgba(155,109,255,0.22);
  border-color: var(--purple);
  color: var(--white);
}

/* ─── POST ─── */
article.post {
  max-width: 720px;
  margin: 0 auto;
  padding: 128px clamp(16px,5vw,56px) 120px;
}
article.post .meta {
  display: flex; align-items: center; gap: 14px;
  color: var(--muted);
  font-family: 'IBM Plex Mono', monospace;
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin-bottom: 24px;
}
article.post .meta a { color: var(--purple-lt); text-decoration: none; }
article.post .meta a:hover { color: var(--purple); }

article.post h1 {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 700;
  font-size: clamp(38px, 6vw, 60px);
  line-height: 1.05;
  letter-spacing: -0.01em;
  margin-bottom: 24px;
  color: var(--white);
}
article.post .lede {
  color: var(--muted);
  font-family: 'Barlow', sans-serif;
  font-size: 19px;
  line-height: 1.55;
  margin-bottom: 44px;
  border-bottom: 1px solid var(--line);
  padding-bottom: 32px;
}

article.post .content {
  font-family: 'Barlow', sans-serif;
  font-size: 17px;
  line-height: 1.7;
  color: var(--white);
}
article.post .content h2 {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 700;
  font-size: 30px;
  letter-spacing: 0.01em;
  margin: 48px 0 14px;
}
article.post .content h3 {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 600;
  font-size: 22px;
  margin: 32px 0 10px;
}
article.post .content p { margin-bottom: 18px; }
article.post .content a {
  color: var(--cyan);
  text-decoration: none;
  border-bottom: 1px solid rgba(0,194,255,0.3);
  transition: border-color 0.2s;
}
article.post .content a:hover { border-bottom-color: var(--cyan); }
article.post .content ul,
article.post .content ol { margin: 0 0 18px 24px; }
article.post .content li { margin-bottom: 8px; }
article.post .content blockquote {
  border-left: 3px solid var(--purple);
  padding: 6px 0 6px 22px;
  margin: 24px 0;
  color: var(--purple-lt);
  font-style: italic;
}
article.post .content code {
  background: var(--surface2);
  padding: 2px 6px;
  border-radius: 3px;
  font-family: 'IBM Plex Mono', monospace;
  font-size: 0.92em;
}
article.post .content pre {
  background: var(--surface);
  border: 1px solid var(--line);
  padding: 16px;
  border-radius: 6px;
  overflow-x: auto;
  margin: 24px 0;
}
article.post .content pre code { background: none; padding: 0; }
article.post .content img {
  max-width: 100%;
  height: auto;
  border-radius: 6px;
  margin: 24px 0;
  display: block;
}
article.post .content hr {
  border: none;
  border-top: 1px solid var(--line);
  margin: 36px 0;
}

/* ─── FOOTER (matches index.html) ─── */
footer {
  padding: 48px 56px;
  display: flex; align-items: center; justify-content: space-between;
  border-top: 1px solid var(--line);
}
.footer-brand { display: flex; align-items: center; gap: 10px; }
.footer-wordmark {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 700; font-size: 20px;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--white);
}
.footer-wordmark em { color: var(--purple); font-style: normal; }
.footer-links { display: flex; flex-wrap: wrap; gap: 28px; }
.footer-link {
  font-size: 15px; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--muted); text-decoration: none;
  transition: color 0.2s;
}
.footer-link:hover { color: var(--white); }
.footer-copy { font-size: 15px; color: var(--muted2); letter-spacing: 0.05em; }

/* ─── Responsive ─── */
@media (max-width: 720px) {
  nav { padding: 0 20px; }
  .nav-links { gap: 16px; }
  .nav-link { font-size: 12px; letter-spacing: 0.1em; }
  .nav-cta { font-size: 12px; padding: 6px 12px; letter-spacing: 0.1em; }
  article.post { padding-top: 104px; }
  footer { padding: 28px 24px; flex-direction: column; align-items: flex-start; gap: 18px; }
  .footer-links { gap: 14px; }
}
@media (max-width: 480px) {
  nav { padding: 0 16px; }
  .nav-link:not(.nav-cta) { display: none; }
}
</style>
</head>
<body>

<nav>
  <a class="nav-brand" href="/">
    <svg width="26" height="26" viewBox="0 0 28 28" fill="none">
      <polygon points="14,2 26,8 26,20 14,26 2,20 2,8" stroke="#9B6DFF" stroke-width="1.5" fill="rgba(155,109,255,0.06)"/>
      <polyline points="7,14 10,10 13,15 16,11 21,14" stroke="#9B6DFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="nav-wordmark">Vector<em> DSP</em></span>
  </a>
  <div class="nav-links">
    <a class="nav-link" href="/blog/">Blog</a>
    <a class="nav-cta" href="/tonelab.html">ToneLab →</a>
  </div>
</nav>

<article class="post">
  <div class="meta">
    <a href="/blog/">← All posts</a>
    <span>·</span>
    <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
  </div>
  <h1>{{ title }}</h1>
  {% if description %}<div class="lede">{{ description }}</div>{% endif %}
  <div class="content">
    {{ content | safe }}
  </div>
</article>

<footer>
  <div class="footer-brand">
    <svg width="22" height="22" viewBox="0 0 28 28" fill="none">
      <polygon points="14,2 26,8 26,20 14,26 2,20 2,8" stroke="#9B6DFF" stroke-width="1.5" fill="rgba(155,109,255,0.06)"/>
      <polyline points="7,14 10,10 13,15 16,11 21,14" stroke="#9B6DFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="footer-wordmark">Vector<em> DSP</em></span>
  </div>
  <div class="footer-links">
    <a class="footer-link" href="/tonelab.html">ToneLab</a>
    <a class="footer-link" href="/blog/">Blog</a>
    <a class="footer-link" href="/terms.html">Terms</a>
    <a class="footer-link" href="/privacy.html">Privacy</a>
    <a class="footer-link" href="/refunds.html">Refunds</a>
  </div>
</footer>

</body>
</html>
